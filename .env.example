# Copy to .env.local (never commit real values; set them in Vercel for production)

# PostgreSQL (Neon in production, local Postgres in development)
DATABASE_URL=postgresql://postgres@localhost:5432/hotel

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in for guests
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend), used from Phase 2
RESEND_API_KEY=

# Seed: passwords for the demo admin and reception accounts (min 12 chars)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
